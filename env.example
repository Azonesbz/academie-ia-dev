# Copiez ce fichier vers .env.local :  cp env.example .env.local
#
# Le starter nu tourne sans aucune clé : SQLite et les sessions ne demandent
# pas de secret. Décommentez les blocs au fur et à mesure des modules activés
# (voir docs/modules/) et déclarez chaque clé dans src/lib/env.ts pour qu'une
# absence se voie dans le tableau de bord.

# --- Identité ---
NEXT_PUBLIC_APP_NAME=Starter
NEXT_PUBLIC_APP_TAGLINE=Le socle d'un micro-SaaS.
# Identifiant technique : nom du cookie de session et du fichier SQLite.
APP_SLUG=starter

# --- Stockage ---
# Répertoire de la base SQLite et des fichiers téléversés.
DATA_DIR=./data

# --- Modèle (docs/modules/ia.md) ---
# ANTHROPIC_API_KEY=

# --- Paiement (docs/modules/paiement-stripe.md) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PRICE_ID=

# --- E-mails transactionnels (docs/modules/emails.md) ---
# RESEND_API_KEY=
# EMAIL_FROM=

# --- Base Postgres (docs/modules/base-postgres.md) ---
# DATABASE_URL=

# --- Mesure d'audience (docs/modules/analytics.md) ---
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
